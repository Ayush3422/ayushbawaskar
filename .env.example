# Environment Variables Template
# Copy this file to .env and add your actual values
# NEVER commit the .env file with real API keys!

# OpenAI API (for chatbot upgrade - optional)
# Get key from: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your-openai-api-key-here

# HuggingFace API (free alternative - optional)
# Get key from: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_TOKEN=your-huggingface-token-here

# Cohere API (free tier - optional)
# Get key from: https://dashboard.cohere.ai/api-keys
VITE_COHERE_API_KEY=your-cohere-api-key-here

# Email service (for contact form - optional)
# VITE_EMAILJS_SERVICE_ID=your-service-id
# VITE_EMAILJS_TEMPLATE_ID=your-template-id
# VITE_EMAILJS_PUBLIC_KEY=your-public-key

# Note: Variables prefixed with VITE_ are exposed to the browser
# For production, use serverless functions to hide API keys
